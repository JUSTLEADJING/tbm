<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.tbm" name="TBM Kodi Repo" version="1.0.0" provider-name="Shaun">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="TBM Kodi Repo">
        <dir>
            <info compressed="false">https://your-github-username.github.io/repository.tbm/addons.xml</info>
            <checksum>https://your-github-username.github.io/repository.tbm/addons.xml.md5</checksum>
            <datadir zip="true">https://your-github-username.github.io/repository.tbm/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Official TBM Repository</summary>
        <description>Personal repository hosting TBM's regional video addons.</description>
        <platform>all</platform>
    </extension>
</addon>